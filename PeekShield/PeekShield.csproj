<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>PeekShield</AssemblyName>
        <RootNamespace>PeekShield</RootNamespace>
        <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <NoWarn>NETSDK1206;NETSDK1057;NU1701;CA1416</NoWarn>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Authors>yty16</Authors>
        <Company>yty16</Company>
        <Product>PeekShield</Product>
        <Copyright>yty16</Copyright>
        <Description>窥屿盾 - 本地离线隐私防窥工具</Description>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.2" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
        <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240615" />
        <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240615" />
        <PackageReference Include="OpenCvSharp4.runtime.linux-x64" Version="4.10.0.20240717" />
        <PackageReference Include="DlibDotNet" Version="19.21.0.20220724" />
        <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
        <PackageReference Include="DirectShowLib" Version="1.0.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Resources\icon.png" />
    </ItemGroup>

    <Target Name="CopyModels" AfterTargets="Build">
        <ItemGroup>
            <_ModelFiles Include="Assets\Models\*.dat" />
        </ItemGroup>
        <Copy SourceFiles="@(_ModelFiles)" DestinationFolder="$(OutDir)Models" SkipUnchangedFiles="true" />
    </Target>

</Project>
