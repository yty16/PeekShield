<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <PeekShieldRuntimeVersion>8.0.27</PeekShieldRuntimeVersion>
        <RuntimeFrameworkVersion>$(PeekShieldRuntimeVersion)</RuntimeFrameworkVersion>
        <OutputType>WinExe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>PeekShield</AssemblyName>
        <RootNamespace>PeekShield</RootNamespace>
        <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <NoWarn>NETSDK1206;NETSDK1057;NU1701;CA1416</NoWarn>
    <Version>1.2.0.2</Version>
    <AssemblyVersion>1.2.0.2</AssemblyVersion>
    <FileVersion>1.2.0.2</FileVersion>
        <Authors>yty16</Authors>
        <Company>yty16</Company>
        <Product>PeekShield</Product>
        <Copyright>yty16</Copyright>
        <Description>窥屿盾 - 本地离线隐私防窥工具</Description>
    </PropertyGroup>

    <PropertyGroup>
        <Deterministic>true</Deterministic>
        <DebugType>none</DebugType>
        <PeekShieldRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../'))</PeekShieldRepoRoot>
        <PathMap>$(PeekShieldRepoRoot)=/PeekShield/</PathMap>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.2" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
        <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240615" />
        <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240615" />
        <PackageReference Include="OpenCvSharp4.runtime.linux-x64" Version="4.10.0.20240717" />
        <PackageReference Include="DlibDotNet" Version="19.21.0.20220724" />
        <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
        <PackageReference Include="DirectShowLib" Version="1.0.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Resources\icon.png" />
    </ItemGroup>

    <Target Name="CopyModels" AfterTargets="Build">
        <ItemGroup>
            <_ModelFiles Include="Assets\Models\*.dat" />
        </ItemGroup>
        <Copy SourceFiles="@(_ModelFiles)" DestinationFolder="$(OutDir)Models" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="VerifyRuntimeVersion" AfterTargets="Build;Publish">
        <PropertyGroup>
            <_RtConfigPath Condition="'$(PublishDir)' != '' And Exists('$(PublishDir)PeekShield.runtimeconfig.json')">$(PublishDir)PeekShield.runtimeconfig.json</_RtConfigPath>
            <_RtConfigPath Condition="'$(_RtConfigPath)' == '' And Exists('$(OutDir)PeekShield.runtimeconfig.json')">$(OutDir)PeekShield.runtimeconfig.json</_RtConfigPath>
        </PropertyGroup>
        <PropertyGroup Condition="'$(_RtConfigPath)' != ''">
            <_RtConfigText>$([System.IO.File]::ReadAllText('$(_RtConfigPath)'))</_RtConfigText>
            <_RtHasFramework>$(_RtConfigText.Contains('"Microsoft.NETCore.App"'))</_RtHasFramework>
            <_RtHasVersion>$(_RtConfigText.Contains('"$(PeekShieldRuntimeVersion)"'))</_RtHasVersion>
        </PropertyGroup>
        <Message Condition="'$(_RtConfigPath)' != ''" Importance="high" Text="[VerifyRuntimeVersion] expected $(PeekShieldRuntimeVersion) | config=$(_RtConfigPath) | framework=$(_RtHasFramework) version=$(_RtHasVersion)" />
        <Error Condition="'$(_RtConfigPath)' != '' And !($(_RtHasFramework) And $(_RtHasVersion))" Text="RUNTIME VERSION MISMATCH in $(_RtConfigPath): pinned version &quot;$(PeekShieldRuntimeVersion)&quot; for Microsoft.NETCore.App was not found. Build aborted to prevent shipping a mismatched bundle. Align RuntimeFrameworkVersion/PeekShieldRuntimeVersion or the NuGet restore." />
    </Target>

</Project>
