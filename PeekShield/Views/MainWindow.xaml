<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PeekShield.MainWindow"
        Title="窥屿盾—PeekShield"
        Width="820" Height="700"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="18">
            <TextBlock Text="窥屿盾"
                       FontSize="28" FontWeight="Bold" />
            <TextBlock Text="本地离线隐私防窥工具"
                       FontSize="14" Opacity="0.75" />

            <Border Padding="18" CornerRadius="10"
                    Background="#1A000000">
                <StackPanel Spacing="10">
                    <TextBlock Text="摄像头" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="CamStatusText"
                               Opacity="0.7" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10"
                    Background="#1A000000">
                <StackPanel Spacing="10">
                    <TextBlock Text="人脸录入" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="EnrollStatusText"
                               Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EnrollBtn" Content="录入当前画面的人脸" Click="OnEnrollClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10"
                    Background="#1A000000">
                <StackPanel Spacing="10">
                    <TextBlock Text="触发后的防护动作" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="检测到偷窥时的反应" FontSize="12" Opacity="0.6" />
                    <CheckBox x:Name="SmartPeekCheck" Content="智能防窥总开关" />
                    <CheckBox x:Name="ActionBlurCheck" Content="屏幕雾化" />
                    <CheckBox x:Name="ActionPopupCheck" Content="顶部弹窗" />
                    <CheckBox x:Name="ActionSoundCheck" Content="提醒音" />
                    <CheckBox x:Name="ActionMinimizeCheck" Content="最小化受保护程序" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</Window>
