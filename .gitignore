# Build output
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/

# .NET / NuGet
*.nupkg
*.snupkg
packages/
**/packages/

# dlib 模型权重（约 120 MB，需从 Release asset 单独下载，见 README）
Assets/Models/*.dat
PeekShield/Assets/Models/*.dat
PeekShield/Models/*.dat

# WorkBuddy 内部产物（记忆、笔记、本地脚本）— 不进公开仓库
.workbuddy/

# 打包好的技能压缩包（不属于项目本身）
avalonia-standalone-desktop.zip

# 自包含分发包（仅作为 GitHub Release asset 上传，不进仓库）
dist/

# 运行时日志
*.log
logs/

# 安装包产物（已作为 GitHub Release asset 上传，不进仓库）
installer/
# installer_source/ 内的 NSIS 安装脚本 peekshield.nsi 为源码需保留，
# 其余均为发布产物二进制堆（DLL / Models / runtimes / .pdb / .h / .lib 等，约 370MB），不进仓库
installer_source/*
!installer_source/peekshield.nsi

# OS / 编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# 启动器 / 测试工具（本地开发用，不进公开仓库）
*.cmd
*.ps1
tests/
*.Tests/
release/
